# Application
APP_NAME=Personal Calorie Tracker API
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8080"]

# Database: runtime role for the API and owner role for migrations.
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-local-app-password@postgres:5432/calorie_tracker
DATABASE_ADMIN_URL=postgresql+asyncpg://calorie_owner:replace-with-local-owner-password@postgres:5432/calorie_tracker
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Authentication
JWT_SECRET=replace-with-a-random-local-secret-of-at-least-32-characters
JWT_ISSUER=personal-calorie-tracker
JWT_AUDIENCE=personal-calorie-tracker-web
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false

# Gemini and uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25
UPLOAD_TEMP_DIR=/tmp/calorie-tracker
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_PDF_BYTES=15728640
MAX_INFLIGHT_AI_REQUESTS=2
AI_SUCCESSES_PER_USER_PER_DAY=10

# Docker Compose-only bootstrap values. Do not use these sample values in production.
POSTGRES_DB=calorie_tracker
POSTGRES_USER=calorie_owner
POSTGRES_PASSWORD=replace-with-local-owner-password
APP_DB_USER=app_user
APP_DB_PASSWORD=replace-with-local-app-password
